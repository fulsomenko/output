# Copy this file to .envrc.local and run: direnv allow
# .envrc.local is git-ignored — safe for machine-specific values.

# Ollama server. Defaults to localhost:11434 if unset.
export OLLAMA_HOST=http://localhost:11434

# Model served by Ollama. Must be pulled first: ollama pull gemma3:4b
export OLLAMA_MODEL=gemma3:4b
