# Copy this file to .envrc.local and run: direnv allow
# .envrc.local is git-ignored — safe for machine-specific values.

# Ollama server. Defaults to localhost:11434 if unset.
export OLLAMA_HOST=http://localhost:11434

# Model served by Ollama. Must be pulled first: ollama pull gemma3:4b
export OLLAMA_MODEL=gemma3:4b

# KRDICT Open API key (32-char hex). Used by 'output lookup <word>'.
# Apply at https://krdict.korean.go.kr/eng/openApi.
# The value may be the key itself, or a path to a file containing the key
# (read at lookup time), e.g. /run/secrets/krdict/api/key.
# This defaults to whatever KRDICT_API_KEY is already set to in your
# environment (shell, CI, container secret), so a copied template does not
# silently clobber a working key with an empty value. To set it here, replace
# ${KRDICT_API_KEY:-} with your 32-char hex key or a path to a file holding it.
export KRDICT_API_KEY=${KRDICT_API_KEY:-}
